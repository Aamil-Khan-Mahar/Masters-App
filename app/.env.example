# Copy to app/.env (never committed) and fill in. Everything here is optional.

# By default the app uses your Claude subscription through the Claude Code CLI
# (run `claude` once to log in). To use the paid API instead, set a key:
# ANTHROPIC_API_KEY=

# auto (default): API if a key is set, else Claude Code. Or force: claude-code | api
# AI_BACKEND=auto

# Default model for every agent: Sonnet. A task can ask for the stronger model
# ("strong" / "Use Opus"), which uses CLAUDE_MODEL_STRONG.
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_MODEL_STRONG=claude-opus-5-5
# Program scoring only (SOP coaching uses CLAUDE_MODEL).
# CLAUDE_MODEL_LIGHT=claude-haiku-5-5

# How many agents may work at once (the rest wait their turn).
# AGENTS_MAX=3

# Folder that holds your Common/ and Applications/. Defaults to data/ beside app/
# (ignored by this repo's git). Relative paths count from the repo root. If you
# point it elsewhere inside the repo, make sure .gitignore covers it.
# DATA_ROOT=
